# Dependencies and build output
node_modules/
coverage/
*.tsbuildinfo
# The binary `go build ./cmd/reach` writes into src/.
/src/reach
# Generated by `wrangler types` (npm run check runs it).
/cloud/worker-configuration.d.ts

# Deployment state and local settings never live in tracked files. The daemon's
# config and the gateway's secrets file are under ~/.config/reach/; checkout-local
# deployment notes, rendered configuration and backups go under .local/.
.local/
.env*
*.env
.dev.vars*
*.log

# Wrangler's local state: dev storage and account caches.
.wrangler/

# Credentials and keys
*.pem
*.key
*.p12
*.pfx
*credentials*.json
*service-account*.json

# Local agent and tool settings
.claude/settings.local.json
.codex/
.agents/
