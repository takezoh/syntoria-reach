{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reach-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Workers logs record requests, not their bodies; the gateway never logs
  // tool arguments or results.
  "observability": { "enabled": true },
  // Deploy at the existing custom domain. Access protects /mcp only; /connect
  // retains node-token authentication and must not require interactive OAuth.
  "workers_dev": false,
  "preview_urls": false,
  // One NodeBroker per node, named by its node ID.
  "durable_objects": {
    "bindings": [{ "name": "NODE", "class_name": "NodeBroker" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NodeBroker"] }],
  // Operator values are uploaded from an ignored secrets file, never tracked:
  //   ACCESS_TEAM_DOMAIN    Access issuer origin, without a trailing slash
  //   ACCESS_AUD            audience of the MCP Access application
  //   ACCESS_OWNER_EMAIL  the owner's email, also restricted by Access policy
  //   NODES                 existing node ID to token JSON map; preserve values
  "secrets": { "required": ["ACCESS_TEAM_DOMAIN", "ACCESS_AUD", "ACCESS_OWNER_EMAIL", "NODES"] }
}
